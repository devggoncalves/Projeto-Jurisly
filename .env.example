# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=altere-esta-chave-para-um-valor-seguro-e-aleatorio
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Banco de dados (PostgreSQL)
# Docker Compose: use host `db`
DATABASE_URL=postgres://jurisly:jurisly@db:5432/jurisly
# Desenvolvimento local sem Docker:
# DATABASE_URL=postgres://jurisly:jurisly@127.0.0.1:5432/jurisly
DATABASE_TEST_NAME=test_jurisly

# Sessão / "Lembrar de mim"
# Tempo em segundos quando "Lembrar de mim" está marcado (padrão: 14 dias)
SESSION_COOKIE_AGE=1209600

# E-mail (desenvolvimento usa console; produção usa SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Jurisly <nao-responda@jurisly.com.br>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Produção (opcional em local)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Integração DJEN / CNJ (API pública)
# Produção (validada 22/09/2026). Homologação: https://hcomunicaapi.cnj.jus.br
DJEN_BASE_URL=https://comunicaapi.pje.jus.br
DJEN_TIMEOUT=30
DJEN_MAX_RETRIES=2
DJEN_ITENS_POR_PAGINA=20
DJEN_DIAS_SINCRONIZACAO=7
# Opção A — proxy HTTP(S) clássico com saída no Brasil
# DJEN_HTTP_PROXY=http://usuario:senha@proxy-br.exemplo:8080
# Opção B — relay temporário (ops/djen_relay) via túnel no PC BR
# DJEN_BASE_URL=https://xxxx.trycloudflare.com
# DJEN_RELAY_SECRET=troque-este-segredo
